###############################################################################
# Secrets
#
# The database password and the JWT signing key are generated by Terraform and
# stored in Secrets Manager. The ECS task definition references them by ARN, so
# the plaintext never appears in a task definition, an environment file, or the
# ECS console - only in Terraform state, which is why the state bucket is
# encrypted and access-controlled.
###############################################################################

resource "random_password" "db" {
  length = 32
  # RDS rejects /, @, " and spaces in a master password.
  override_special = "!#$%&*()-_=+[]{}<>:?"
  special          = true
}

resource "random_password" "jwt_secret" {
  length  = 64
  special = false # base62 keeps it shell- and YAML-safe while staying far above the HS256 minimum
}

resource "aws_secretsmanager_secret" "db" {
  name        = "${local.name_prefix}/database"
  description = "RDS MySQL master credentials for the CRM platform"

  # Zero in non-prod so `terraform destroy` followed by `apply` does not collide
  # with a secret still in the recovery window.
  recovery_window_in_days = var.environment == "prod" ? 30 : 0

  tags = {
    Name = "${local.name_prefix}-db-secret"
  }
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id

  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db.result
    engine   = "mysql"
    host     = aws_db_instance.mysql.address
    port     = aws_db_instance.mysql.port
    dbname   = var.db_name
  })
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${local.name_prefix}/jwt-secret"
  description             = "HS256 signing key for access and refresh tokens"
  recovery_window_in_days = var.environment == "prod" ? 30 : 0

  tags = {
    Name = "${local.name_prefix}-jwt-secret"
  }
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = random_password.jwt_secret.result
}

###############################################################################
# IAM
#
# Two roles, on purpose:
#   execution role - used by the ECS agent to pull images and read secrets at
#                    task start-up
#   task role      - the identity the application itself runs as
#
# The application never needs to read a secret at runtime (they are injected as
# environment variables at start-up), so the task role carries no Secrets
# Manager permission at all.
###############################################################################

data "aws_iam_policy_document" "ecs_assume_role" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }

    condition {
      test     = "StringEquals"
      variable = "aws:SourceAccount"
      values   = [local.account_id]
    }
  }
}

resource "aws_iam_role" "ecs_task_execution" {
  name               = "${local.name_prefix}-ecs-execution"
  assume_role_policy = data.aws_iam_policy_document.ecs_assume_role.json

  tags = {
    Name = "${local.name_prefix}-ecs-execution"
  }
}

resource "aws_iam_role_policy_attachment" "ecs_task_execution" {
  role       = aws_iam_role.ecs_task_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

# Scoped to exactly the two secrets this stack owns, not secretsmanager:* .
data "aws_iam_policy_document" "read_secrets" {
  statement {
    sid    = "ReadStackSecrets"
    effect = "Allow"

    actions = [
      "secretsmanager:GetSecretValue",
      "secretsmanager:DescribeSecret",
    ]

    resources = [
      aws_secretsmanager_secret.db.arn,
      aws_secretsmanager_secret.jwt.arn,
    ]
  }
}

resource "aws_iam_role_policy" "ecs_task_execution_secrets" {
  name   = "${local.name_prefix}-read-secrets"
  role   = aws_iam_role.ecs_task_execution.id
  policy = data.aws_iam_policy_document.read_secrets.json
}

resource "aws_iam_role" "ecs_task" {
  name               = "${local.name_prefix}-ecs-task"
  assume_role_policy = data.aws_iam_policy_document.ecs_assume_role.json

  tags = {
    Name = "${local.name_prefix}-ecs-task"
  }
}

# Just enough for `aws ecs execute-command` to work for debugging a running task.
data "aws_iam_policy_document" "task_exec_command" {
  statement {
    sid    = "AllowSessionManagerChannel"
    effect = "Allow"

    actions = [
      "ssmmessages:CreateControlChannel",
      "ssmmessages:CreateDataChannel",
      "ssmmessages:OpenControlChannel",
      "ssmmessages:OpenDataChannel",
    ]

    resources = ["*"]
  }
}

resource "aws_iam_role_policy" "ecs_task_exec_command" {
  name   = "${local.name_prefix}-exec-command"
  role   = aws_iam_role.ecs_task.id
  policy = data.aws_iam_policy_document.task_exec_command.json
}
