# Copy to .env before running `docker compose up --build`.
# .env is git-ignored; in AWS these values come from Secrets Manager, not from a file.

# --- database ---------------------------------------------------------------------
DB_NAME=crm
DB_USERNAME=crm_app
DB_PASSWORD=crm_app_password
MYSQL_ROOT_PASSWORD=root_password
DB_PORT=3306
DB_POOL_MAX=20

# --- security ---------------------------------------------------------------------
# Must be at least 32 characters: HS256 rejects shorter key material.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_ISSUER=slate-crm
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma separated allowlist. Same-origin in production, so only the dev server needs listing.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- ports ------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8080

# --- logging ----------------------------------------------------------------------
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
